# ============================================================
# ROSS-SEARCH Backend — Environment Variables Configuration
# ============================================================
# Copy this file to .env and configure for your deployment environment.
# NEVER commit .env to version control.

# ----- Application -----
APP_NAME=ROSS-SEARCH API
APP_VERSION=1.0.0
DEBUG=False

# ----- Security & JWT Authentication -----
# Generate a secure 64-char hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- PostgreSQL Database (Production Target) -----
# Standard PostgreSQL URI format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/ross_search

# ----- Alternative Cloud PostgreSQL Providers (e.g., Render, Neon, Supabase) -----
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/ross_search?sslmode=require

# ----- Local Development Fallback -----
# DATABASE_URL=sqlite:///./ross_search.db

# ----- CORS Configuration -----
# Comma-separated list of permitted frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://kalonakre.github.io
